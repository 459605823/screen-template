{
  "name": "screen-template",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.8.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "simple-git-hooks",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint:script": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:style": "stylelint src\"/**/*.+(vue|css|scss|less|stylus|sass|postcss)\"",
    "format:script": "prettier --write src/",
    "format:style": "stylelint src\"/**/*.+(vue|css|scss|less|stylus|sass|postcss)\" --fix",
    "format": "npm run format:script && npm run format:style"
  },
  "dependencies": {
    "@unocss/reset": "^0.51.13",
    "@vueuse/core": "^10.1.2",
    "ant-design-vue": "4.x",
    "autoprefixer": "^10.4.14",
    "d3": "^7.8.4",
    "dayjs": "^1.11.7",
    "echarts": "^5.4.2",
    "echarts-gl": "^2.0.9",
    "echarts-wordcloud": "^2.1.0",
    "flag-icons": "^6.9.1",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "vue": "^3.3.2",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.2.0",
    "@tsconfig/node18": "^2.0.1",
    "@types/d3": "^7.4.0",
    "@types/lodash-es": "^4.17.7",
    "@types/node": "^18.16.8",
    "@unocss/eslint-config": "^0.53.5",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.39.0",
    "eslint-plugin-vue": "^9.11.0",
    "lint-staged": "^13.2.3",
    "npm-run-all": "^4.1.5",
    "postcss-px2vwvh": "^0.3.3",
    "postcss-scss": "^4.0.4",
    "prettier": "^2.8.8",
    "sass": "^1.62.1",
    "simple-git-hooks": "^2.11.1",
    "stylelint": "^15.10.2",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^10.0.0",
    "typescript": "~5.0.4",
    "unocss": "^0.51.13",
    "unplugin-auto-import": "^0.15.3",
    "unplugin-vue-components": "^0.24.1",
    "unplugin-vue-router": "^0.7.0",
    "vite": "^4.4.8",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^1.6.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "volta": {
    "node": "20.17.0",
    "pnpm": "9.8.0"
  }
}
